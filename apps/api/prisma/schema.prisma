// Integrated Travel Support Platform - Database Schema
// PostgreSQL + Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// Enums
// -------------------------------------------------------------

enum UserRole {
  traveler
  partner_storage
  partner_transport
  admin
  support
}

enum PartnerType {
  storage
  transport
  both
}

enum PartnerStatus {
  pending
  verified
  suspended
  rejected
}

enum VerificationStatus {
  pending
  verified
  suspended
}

enum TripStatus {
  planning
  confirmed
  in_progress
  completed
  cancelled
}

enum ItineraryItemType {
  flight
  hotel
  activity
  storage
  transport
}

enum StorageBookingStatus {
  pending
  confirmed
  checked_in
  checked_out
  cancelled
  expired
}

enum TransportMode {
  taxi
  rideshare
  transit
  bike
}

enum TransportBookingStatus {
  pending
  confirmed
  completed
  cancelled
  failed
}

enum PaymentRelatedType {
  storage_booking
  transport_booking
}

enum PaymentStatus {
  intent
  authorized
  captured
  refunded
  failed
}

enum ReviewRelatedType {
  storage_location
  transport_option
  platform
}

enum NotificationChannel {
  email
  sms
  push
  in_app
}

enum NotificationStatus {
  pending
  sent
  failed
  delivered
}

// -------------------------------------------------------------
// Models
// -------------------------------------------------------------

model User {
  id                String       @id @default(uuid())
  email             String       @unique
  password_hash     String
  full_name         String
  phone             String?
  role              UserRole     @default(traveler)
  email_verified_at DateTime?
  created_at        DateTime     @default(now())
  updated_at        DateTime     @updatedAt
  deleted_at        DateTime?    // Soft-delete support

  // Relations
  partner_account    PartnerAccount?
  trips              Trip[]
  storage_bookings   StorageBooking[]
  transport_bookings TransportBooking[]
  payments           Payment[]
  reviews            Review[]
  notifications      Notification[]
  refresh_tokens     RefreshToken[]
  actor_audit_events AuditEvent[]     @relation("ActorAuditEvents")

  @@index([email])
  @@index([role])
  @@index([deleted_at])
  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid())
  user_id    String
  token_hash String    @unique
  expires_at DateTime
  revoked_at DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([token_hash])
  @@map("refresh_tokens")
}

model PartnerAccount {
  id          String         @id @default(uuid())
  user_id     String         @unique
  type        PartnerType
  status      PartnerStatus  @default(pending)
  verified_at DateTime?
  created_at  DateTime       @default(now())
  updated_at  DateTime       @updatedAt

  user               User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  storage_provider   StorageProvider?
  transport_provider TransportProvider?

  @@index([status])
  @@index([type])
  @@map("partner_accounts")
}

model StorageProvider {
  id                 String             @id @default(uuid())
  partner_account_id String             @unique
  business_name      String
  verification_status VerificationStatus @default(pending)
  payout_details_ref String?
  created_at         DateTime           @default(now())
  updated_at         DateTime           @updatedAt

  partner_account PartnerAccount   @relation(fields: [partner_account_id], references: [id], onDelete: Cascade)
  locations       StorageLocation[]

  @@index([verification_status])
  @@map("storage_providers")
}

model StorageLocation {
  id                       String             @id @default(uuid())
  provider_id              String
  name                     String
  lat                      Float
  lng                      Float
  address                  String
  city                     String             @default("Berlin")
  opening_hours            Json               // e.g. {"mon": {"open": "08:00", "close": "20:00"}}
  accepted_item_categories Json               // e.g. ["luggage", "backpack", "odd_size"]
  max_bag_size             String             // e.g. "large", "cabin", "oversized"
  photos                   Json               // array of image URLs
  is_active                Boolean            @default(true)
  created_at               DateTime           @default(now())
  updated_at               DateTime           @updatedAt

  provider    StorageProvider    @relation(fields: [provider_id], references: [id], onDelete: Cascade)
  inventories StorageInventory[]
  bookings    StorageBooking[]

  @@index([provider_id])
  @@index([lat, lng])
  @@index([city])
  @@index([is_active])
  @@map("storage_locations")
}

model StorageInventory {
  id                    String          @id @default(uuid())
  location_id           String
  date                  DateTime        @db.Date
  total_capacity        Int
  booked_capacity       Int             @default(0)
  price_per_bag_per_day Decimal         @db.Decimal(10, 2)
  created_at            DateTime        @default(now())
  updated_at            DateTime        @updatedAt

  location StorageLocation @relation(fields: [location_id], references: [id], onDelete: Cascade)

  @@unique([location_id, date])
  @@index([date])
  @@map("storage_inventories")
}

model Trip {
  id                String       @id @default(uuid())
  user_id           String
  title             String
  origin_place      String
  destination_place String
  start_date        DateTime
  end_date          DateTime
  timezone          String       @default("UTC")
  status            TripStatus   @default(planning)
  created_at        DateTime     @default(now())
  updated_at        DateTime     @updatedAt
  deleted_at        DateTime?    // Soft-delete support

  user               User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  itinerary_items    ItineraryItem[]
  storage_bookings   StorageBooking[]
  transport_bookings TransportBooking[]

  @@index([user_id])
  @@index([start_date, end_date])
  @@index([deleted_at])
  @@map("trips")
}

model ItineraryItem {
  id                          String            @id @default(uuid())
  trip_id                     String
  type                        ItineraryItemType
  title                       String
  location_lat                Float?
  location_lng                Float?
  address                     String?
  starts_at                   DateTime
  ends_at                     DateTime
  sequence_order              Int               @default(0)
  linked_storage_booking_id   String?
  linked_transport_booking_id String?
  created_at                  DateTime          @default(now())
  updated_at                  DateTime          @updatedAt

  trip                     Trip              @relation(fields: [trip_id], references: [id], onDelete: Cascade)
  linked_storage_booking   StorageBooking?   @relation(fields: [linked_storage_booking_id], references: [id], onDelete: SetNull)
  linked_transport_booking TransportBooking? @relation(fields: [linked_transport_booking_id], references: [id], onDelete: SetNull)

  @@index([trip_id])
  @@index([starts_at, ends_at])
  @@map("itinerary_items")
}

model StorageBooking {
  id              String               @id @default(uuid())
  user_id         String
  location_id     String
  trip_id         String?
  status          StorageBookingStatus @default(pending)
  bag_count       Int                  @default(1)
  drop_off_at     DateTime
  pick_up_at      DateTime
  price_total     Decimal              @db.Decimal(10, 2)
  currency        String               @default("USD")
  idempotency_key String               @unique
  created_at      DateTime             @default(now())
  updated_at      DateTime             @updatedAt
  deleted_at      DateTime?            // Soft-delete support

  user            User                 @relation(fields: [user_id], references: [id], onDelete: Cascade)
  location        StorageLocation      @relation(fields: [location_id], references: [id], onDelete: Restrict)
  trip            Trip?                @relation(fields: [trip_id], references: [id], onDelete: SetNull)
  itinerary_items ItineraryItem[]

  @@index([user_id])
  @@index([location_id])
  @@index([status])
  @@index([drop_off_at, pick_up_at])
  @@index([deleted_at])
  @@map("storage_bookings")
}

model TransportProvider {
  id                 String             @id @default(uuid())
  partner_account_id String             @unique
  name               String
  modes_supported    Json               // e.g. ["taxi", "rideshare", "transit", "bike"]
  verification_status VerificationStatus @default(pending)
  created_at         DateTime           @default(now())
  updated_at         DateTime           @updatedAt

  partner_account PartnerAccount    @relation(fields: [partner_account_id], references: [id], onDelete: Cascade)
  options         TransportOption[]

  @@index([verification_status])
  @@map("transport_providers")
}

model TransportOption {
  id                     String        @id @default(uuid())
  provider_id            String
  mode                   TransportMode
  origin_lat             Float
  origin_lng             Float
  destination_lat        Float
  destination_lng        Float
  estimated_price        Decimal       @db.Decimal(10, 2)
  currency               String        @default("USD")
  estimated_duration_min Int
  deep_link_url          String?       // Hand-off provider deep link
  created_at             DateTime      @default(now())
  updated_at             DateTime      @updatedAt

  provider TransportProvider  @relation(fields: [provider_id], references: [id], onDelete: Cascade)
  bookings TransportBooking[]

  @@index([provider_id])
  @@index([mode])
  @@map("transport_options")
}

model TransportBooking {
  id                  String                 @id @default(uuid())
  user_id             String
  transport_option_id String
  trip_id             String?
  status              TransportBookingStatus @default(pending)
  scheduled_at        DateTime
  price_total         Decimal                @db.Decimal(10, 2)
  currency            String                 @default("USD")
  idempotency_key     String                 @unique
  created_at          DateTime               @default(now())
  updated_at          DateTime               @updatedAt
  deleted_at          DateTime?              // Soft-delete support

  user             User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transport_option TransportOption @relation(fields: [transport_option_id], references: [id], onDelete: Restrict)
  trip             Trip?           @relation(fields: [trip_id], references: [id], onDelete: SetNull)
  itinerary_items  ItineraryItem[]

  @@index([user_id])
  @@index([transport_option_id])
  @@index([status])
  @@index([deleted_at])
  @@map("transport_bookings")
}

model Payment {
  id              String             @id @default(uuid())
  user_id         String
  related_type    PaymentRelatedType
  related_id      String
  status          PaymentStatus      @default(intent)
  amount          Decimal            @db.Decimal(10, 2)
  currency        String             @default("USD")
  provider_ref    String?            // External reference from Stripe / Mock
  idempotency_key String?            @unique
  created_at      DateTime           @default(now())
  updated_at      DateTime           @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([related_type, related_id])
  @@index([status])
  @@map("payments")
}

model Review {
  id           String            @id @default(uuid())
  user_id      String
  related_type ReviewRelatedType
  related_id   String
  rating       Int               // 1 to 5
  comment      String?
  created_at   DateTime          @default(now())
  updated_at   DateTime          @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([related_type, related_id])
  @@map("reviews")
}

model Notification {
  id         String              @id @default(uuid())
  user_id    String
  channel    NotificationChannel
  template   String
  payload    Json
  status     NotificationStatus  @default(pending)
  sent_at    DateTime?
  created_at DateTime            @default(now())
  updated_at DateTime            @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([status])
  @@map("notifications")
}

model AuditEvent {
  id            String   @id @default(uuid())
  actor_user_id String?
  action        String
  entity_type   String
  entity_id     String
  before_state  Json?
  after_state   Json?
  correlation_id String
  created_at    DateTime @default(now())

  actor User? @relation("ActorAuditEvents", fields: [actor_user_id], references: [id], onDelete: SetNull)

  @@index([actor_user_id])
  @@index([entity_type, entity_id])
  @@index([correlation_id])
  @@index([created_at])
  @@map("audit_events")
}
