# Environment Configuration

NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/travel_platform?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Authentication & Security
JWT_ACCESS_SECRET="travel_platform_super_secret_access_key_change_in_production"
JWT_REFRESH_SECRET="travel_platform_super_secret_refresh_key_change_in_production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Integration Adapters (default: mock)
MAPS_PROVIDER="mock"
MAPS_API_KEY=""

PAYMENTS_PROVIDER="mock"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

NOTIFICATIONS_PROVIDER="console"
SENDGRID_API_KEY=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""

# Frontend App URLs (for CORS)
WEB_APP_URL="http://localhost:3000"
PARTNER_PORTAL_URL="http://localhost:3001"
ADMIN_PORTAL_URL="http://localhost:3002"
